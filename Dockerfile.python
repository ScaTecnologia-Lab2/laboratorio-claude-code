# ============================================================================
# Dockerfile.python — API de Fornecedores (src/fornecedores_api.py)
# ----------------------------------------------------------------------------
# Uso normal: `docker compose up --build`.
# Isolado:    docker build -f Dockerfile.python -t labsystem-fornecedores .
# ============================================================================
FROM python:3.13-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1
RUN addgroup --system app && adduser --system --ingroup app app
# Aplica as correções de segurança do Debian publicadas depois da imagem
# base: a python:3.13-slim às vezes atrasa, e o Trivy (ignore-unfixed)
# barra toda CVE que já tem correção (ex.: CVE-2026-103111 na libpcre2).
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
# Instala as dependências e depois remove as ferramentas de empacotamento
# (pip/setuptools/wheel e as cópias em ensurepip): o runtime não precisa
# delas, e elas carregam CVEs HIGH que o Trivy acusaria.
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall -y setuptools wheel \
    && python -m pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3*/ensurepip
COPY src/fornecedores_api.py ./src/fornecedores_api.py
USER app
EXPOSE 3001
CMD ["python", "src/fornecedores_api.py"]
